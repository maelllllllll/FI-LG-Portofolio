---
import Base from '../layouts/Base.astro';
import { identite, sections } from '../data/site.js';

const nomComplet = `${identite.prenom} ${identite.nom}`;
---

<Base
  titre={`${nomComplet} — Portfolio`}
  description={`Portfolio de ${nomComplet} : ${identite.titres.join(', ')}.`}
>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="hero">
    <img
      class="hero__fond"
      src={identite.imageFond}
      alt=""
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__voile" aria-hidden="true"></div>

    <div class="contenu hero__texte">
      <h1 class="hero__nom">
        <span>{identite.prenom}</span>
        <span>{identite.nom}</span>
      </h1>

      <ul class="hero__titres">
        {identite.titres.map((titre) => <li>{titre}</li>)}
      </ul>
    </div>

    <a class="hero__descendre" href="#portrait" aria-label="Découvrir">
      <span aria-hidden="true"></span>
    </a>
  </section>

  {/* ------------------------------------------------------------ Portrait */}
  <section class="portrait contenu" id="portrait">
    <figure class="portrait__figure apparait">
      <img src={identite.portrait} alt={`Portrait de ${nomComplet}`} loading="lazy" />
      {
        identite.portraitLegende && (
          <figcaption>{identite.portraitLegende}</figcaption>
        )
      }
    </figure>

    <div class="portrait__texte apparait">
      <p class="surtitre">Portrait</p>
      <p class="portrait__accroche">{nomComplet}</p>
      {identite.bio && <p class="portrait__bio">{identite.bio}</p>}
    </div>
  </section>

  {/* ------------------------------------------------------------ Sections */}
  <section class="acces" aria-labelledby="acces-titre">
    <div class="contenu">
      <p class="surtitre">Le portfolio</p>
      <h2 class="acces__titre" id="acces-titre">Quatre chapitres</h2>
    </div>

    <ul class="acces__liste contenu">
      {
        sections.map((section) => (
          <li class="apparait">
            <a class="carte" href={`/${section.slug}`}>
              <span class="carte__image">
                <img src={section.couverture} alt="" loading="lazy" />
              </span>
              <span class="carte__corps">
                <span class="carte__numero">{section.numero}</span>
                <span class="carte__titre">{section.titre}</span>
                <span class="carte__soustitre">{section.sousTitre}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* --- Hero --------------------------------------------------------------- */

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(4rem, 12vh, 9rem);
    overflow: hidden;
  }

  .hero__fond {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__voile {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(16 15 13 / 0.55) 0%,
      rgb(16 15 13 / 0.15) 35%,
      rgb(16 15 13 / 0.75) 85%,
      var(--noir) 100%
    );
  }

  .hero__texte {
    position: relative;
  }

  .hero__nom {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.75rem, 11vw, 9.5rem);
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  .hero__nom span:last-child {
    padding-left: clamp(1rem, 6vw, 6rem);
  }

  @media (min-width: 54rem) {
    .hero__nom span:last-child {
      color: transparent;
      -webkit-text-stroke: 1px var(--creme);
      text-stroke: 1px var(--creme);
    }
  }

  .hero__titres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem clamp(1rem, 3vw, 2.25rem);
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__titres li {
    font-size: clamp(0.72rem, 0.68rem + 0.2vw, 0.85rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--texte-sourd);
  }

  .hero__titres li + li::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: clamp(1rem, 3vw, 2.25rem);
    background: var(--accent);
    vertical-align: middle;
  }

  .hero__descendre {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    translate: -50% 0;
    width: 1px;
    height: clamp(2.5rem, 6vh, 4rem);
    background: rgb(242 236 225 / 0.25);
    overflow: hidden;
  }

  .hero__descendre span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: filer 2.4s cubic-bezier(0.76, 0, 0.24, 1) infinite;
  }

  @keyframes filer {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  /* --- Portrait ----------------------------------------------------------- */

  .portrait {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(4rem, 14vh, 10rem);
  }

  .portrait__figure {
    margin: 0;
    position: relative;
  }

  .portrait__figure img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .portrait__figure figcaption {
    margin-top: 0.85rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(242 236 225 / 0.45);
  }

  .portrait__accroche {
    font-family: var(--display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    text-transform: uppercase;
    line-height: 1.05;
    margin: 1rem 0 0;
  }

  .portrait__bio {
    margin: 1.5rem 0 0;
    max-width: 44ch;
    color: var(--texte-sourd);
  }

  /* --- Accès aux sections ------------------------------------------------- */

  .acces {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .acces__titre {
    font-size: clamp(1.75rem, 5vw, 3.5rem);
    margin-top: 0.75rem;
  }

  .acces__liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding-block: 0;
    list-style: none;
  }

  .carte {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--noir-doux);
  }

  .carte__image {
    display: block;
    overflow: hidden;
  }

  .carte__image img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform var(--lent), filter var(--lent);
    filter: grayscale(0.35) brightness(0.8);
  }

  .carte:hover .carte__image img,
  .carte:focus-visible .carte__image img {
    transform: scale(1.05);
    filter: grayscale(0) brightness(0.95);
  }

  .carte__corps {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background: linear-gradient(
      to top,
      rgb(16 15 13 / 0.92),
      rgb(16 15 13 / 0)
    );
  }

  .carte__numero {
    font-family: var(--display);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    color: var(--accent);
  }

  .carte__titre {
    font-family: var(--display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .carte__soustitre {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(242 236 225 / 0.5);
  }
</style>
