---
import Base from '../layouts/Base.astro';
import { sections, identity, href } from '../data/site.js';
import { AsciiFlow } from '../components/ui/ascii-effect.tsx';
import { NewsletterBookshelf } from '../components/ui/newsletter-bookshelf.tsx';

// One page per entry in `sections` (src/data/site.js).
export function getStaticPaths() {
  return sections.map((section, index) => ({
    params: { slug: section.slug },
    props: {
      section,
      next: sections[(index + 1) % sections.length],
    },
  }));
}

const { section, next } = Astro.props;
const fullName = `${identity.firstName} ${identity.lastName}`;
---

<Base
  title={`${section.title} — ${fullName}`}
  description={section.intro}
>
  {
    section.asciiHero && (
      <div class="ascii-piste">
      <section class="ascii" aria-labelledby="ascii-titre">
        {/* La source est un négatif : trait clair sur fond noir. brightnessBoost
            relève le trait, que l'échantillonnage en grille dilue fortement ;
            un zoom (scale) l'épaissit encore par rapport à la cellule. */}
        <AsciiFlow
          client:load
          className="ascii__rendu"
          imageSrc={section.asciiHero.src}
          alt={section.asciiHero.alt}
          chars=" .:-=+*#%@"
          fontSize={8}
          brightnessBoost={5.5}
          contrast={1}
          threshold={0.015}
          posterize={16}
          ditherStrength={0.6}
          colors={['#6b5836', '#b8925a', '#f2ece1']}
          backgroundColor="#100f0d"
          fit="cover"
          scale={2.6}
          flowSpeed={0.16}
          flowStrength={9}
          mouseRadius={180}
          mouseStrength={26}
        />

        <div class="ascii__texte contenu">
          <p class="surtitre">{section.number} — {section.subtitle}</p>
          <p class="ascii__titre" id="ascii-titre">{section.title}</p>
        </div>

        <span class="ascii__descendre" aria-hidden="true"></span>
      </section>
      </div>
    )
  }

  {
    section.asciiHero ? (
      /* Le titre est déjà affiché sur l'écran d'atterrissage : on enchaîne
         directement sur les visuels, sans le répéter. */
      <h1 class="invisible">{section.title}</h1>
    ) : (
      <header class="tete">
        <div class="contenu">
          <p class="surtitre">{section.number} — {section.subtitle}</p>
          <h1 class="tete__titre">{section.title}</h1>
          {section.intro && <p class="tete__chapo">{section.intro}</p>}
        </div>
      </header>
    )
  }

  {
    section.brand && (
      <section class="marque contenu" aria-labelledby="marque-titre">
        <h2 class="invisible" id="marque-titre">The brand</h2>

        <figure class="marque__blason apparait">
          <img src={section.brand.emblem} alt="Fête Impériale crest" loading="lazy" />
        </figure>

        <div class="marque__texte apparait">
          <p class="marque__statement">{section.brand.statement}</p>

          <dl class="marque__faits">
            {section.brand.facts.map((fait) => (
              <div>
                <dt>{fait.label}</dt>
                <dd>{fait.value}</dd>
              </div>
            ))}
          </dl>

          <p class="surtitre marque__surtitre">Selected collaborations</p>
          <ul class="marque__collabs">
            {section.brand.collaborations.map((collab) => (
              <li>
                <span class="marque__collab-nom">{collab.name}</span>
                <span class="marque__collab-note">{collab.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    section.collections && (
      <section class="rayon" aria-labelledby="rayon-titre">
        <div class="contenu">
          <p class="surtitre">Collections</p>
          <h2 class="rayon__titre" id="rayon-titre">{section.collections.length} collections</h2>
          <p class="rayon__aide">
            Drag sideways to browse. Click a volume to bring it forward.
          </p>
        </div>

        <NewsletterBookshelf
          client:visible
          className="rayon__etagere bg-noir text-creme"
          items={section.collections}
          brand="Fête Impériale"
          height={560}
        />
      </section>
    )
  }

  {
    section.groups?.map((group) => (
      <section class="groupe">
        <div class="contenu">
          <h2 class="groupe__titre">{group.title}</h2>
          {group.subtitle && <p class="groupe__soustitre">{group.subtitle}</p>}
        </div>

        <ul class:list={['galerie', 'contenu', group.images.length === 1 && 'galerie--solo']}>
          {group.images.map((image) => (
            <li class={`galerie__item apparait galerie__item--${image.format ?? 'portrait'}`}>
              <figure>
                <img src={image.src} alt={image.alt ?? ''} loading="lazy" />
                {image.caption && <figcaption>{image.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    section.images.length > 0 && (
      <ul class:list={['galerie', 'contenu', section.images.length === 1 && 'galerie--solo']}>
        {section.images.map((image) => (
          <li class={`galerie__item apparait galerie__item--${image.format ?? 'portrait'}`}>
            <figure>
              <img src={image.src} alt={image.alt ?? ''} loading="lazy" />
              {image.caption && <figcaption>{image.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    )
  }

  {
    section.images.length === 0 && !section.groups && !section.collections && (
      <p class="contenu galerie__vide">
        Visuals for this chapter are coming soon.
      </p>
    )
  }

  <nav class="suite contenu" aria-label="Next chapter">
    <hr class="filet" />
    <a class="suite__lien" href={href(next.slug)}>
      <span class="surtitre">Next chapter</span>
      <span class="suite__titre">{next.title}</span>
    </a>
  </nav>
</Base>

<script>
  // Traduit le défilement sur la piste en une valeur de 0 à 1, que le CSS
  // utilise pour éteindre progressivement l'atterrissage.
  const piste = document.querySelector('.ascii-piste');
  const ascii = piste?.querySelector('.ascii');

  if (piste && ascii && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let enAttente = false;

    const mesurer = () => {
      enAttente = false;
      const course = piste.offsetHeight - window.innerHeight;
      if (course <= 0) return;
      const avance = Math.min(1, Math.max(0, -piste.getBoundingClientRect().top / course));
      ascii.style.setProperty('--sortie', avance.toFixed(4));
    };

    // Le défilement se déclenche bien plus souvent que l'écran ne se rafraîchit :
    // on ne recalcule qu'une fois par image.
    const planifier = () => {
      if (enAttente) return;
      enAttente = true;
      requestAnimationFrame(mesurer);
    };

    addEventListener('scroll', planifier, { passive: true });
    addEventListener('resize', planifier);
    mesurer();
  }
</script>

<style>
  /* --- Atterrissage ASCII -------------------------------------------------- */

  /* La piste est plus haute que l'écran : l'atterrissage y reste fixe le
     temps qu'on la traverse, puis se laisse recouvrir par la suite de la
     page. C'est ce décalage qui fait le fondu, sans coupure nette. */
  .ascii-piste {
    height: 175svh;
  }

  .ascii {
    position: sticky;
    top: 0;
    height: 100svh;
    background: var(--noir);
    overflow: hidden;

    /* Progression du défilement sur la piste, de 0 à 1. Alimentée plus bas
       par le script ; sans JavaScript elle reste à 0 et rien ne bouge. */
    --sortie: 0;
  }

  .ascii__rendu {
    opacity: calc(1 - var(--sortie) * 0.9);
    transform: scale(calc(1 + var(--sortie) * 0.08));
    transform-origin: center;
    will-change: opacity, transform;
  }

  /* Les caractères sont trop contrastés pour laisser passer du texte :
     un voile progressif rend le titre lisible sans masquer le motif. */
  .ascii::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: calc(55% + var(--sortie) * 45%);
    background: linear-gradient(
      to top,
      rgb(16 15 13 / 0.96) 0%,
      rgb(16 15 13 / 0.72) 40%,
      rgb(16 15 13 / 0) 100%
    );
    pointer-events: none;
  }

  .ascii__texte {
    position: absolute;
    z-index: 1;
    inset: auto 0 clamp(3.5rem, 12vh, 8rem) 0;
    pointer-events: none;
    opacity: calc(1 - var(--sortie) * 1.8);
    transform: translateY(calc(var(--sortie) * -2.5rem));
  }

  .ascii__titre {
    font-family: var(--display);
    font-size: clamp(2.25rem, 9vw, 7rem);
    text-transform: uppercase;
    line-height: 1;
    margin: 0.75rem 0 0;
    text-shadow: 0 2px 30px rgb(16 15 13 / 0.8);
  }

  .ascii__descendre {
    position: absolute;
    z-index: 1;
    opacity: calc(1 - var(--sortie) * 3);
    bottom: 1.75rem;
    left: 50%;
    translate: -50% 0;
    width: 1px;
    height: clamp(2rem, 5vh, 3.5rem);
    background: linear-gradient(to bottom, transparent, var(--accent));
  }

  /* Sur la page d'atterrissage, le titre est déjà affiché par-dessus le
     rendu ASCII : on resserre l'en-tête qui suit pour éviter la redite. */
  /* La galerie remonte par-dessus l'atterrissage fixe : son propre fond la
     détache, et le décalage négatif supprime le vide laissé par la piste. */
  .ascii-piste ~ .galerie {
    position: relative;
    z-index: 1;
    background: var(--noir);
    margin-top: -35svh;
    padding-top: clamp(3.5rem, 10vw, 7rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .ascii-piste {
      height: 100svh;
    }

    .ascii__rendu,
    .ascii__texte,
    .ascii__descendre {
      opacity: 1;
      transform: none;
    }

    .ascii-piste ~ .galerie {
      margin-top: 0;
    }
  }

  .tete {
    padding-top: clamp(7rem, 18vh, 12rem);
    padding-bottom: clamp(2.5rem, 7vw, 5rem);
  }

  .tete__titre {
    font-size: clamp(2.25rem, 9vw, 7rem);
    margin-top: 0.85rem;
  }

  .tete__chapo {
    max-width: 52ch;
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    color: var(--texte-sourd);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
  }

  /* --- La marque ----------------------------------------------------------- */

  .marque {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-block: clamp(1rem, 4vw, 3rem) clamp(3rem, 8vw, 5rem);
  }

  .marque__blason {
    margin: 0;
    max-width: 18rem;
  }

  .marque__blason img {
    width: 100%;
  }

  .marque__statement {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    color: var(--texte-sourd);
  }

  .marque__faits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: 1.25rem 2rem;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
  }

  .marque__faits dt {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .marque__faits dd {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
  }

  .marque__surtitre {
    margin-top: clamp(2.25rem, 5vw, 3rem);
  }

  .marque__collabs {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .marque__collabs li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgb(242 236 225 / 0.1);
  }

  .marque__collab-nom {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    min-width: 9rem;
  }

  .marque__collab-note {
    color: var(--texte-sourd);
    font-size: 0.9rem;
  }

  /* --- Étagère des collections -------------------------------------------- */

  .rayon {
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  .rayon__titre {
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    margin-top: 0.75rem;
  }

  .rayon__aide {
    margin: 1rem 0 0;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(242 236 225 / 0.45);
  }

  .rayon__etagere {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    border-block: 1px solid rgb(242 236 225 / 0.12);
  }

  /* --- Sous-parties -------------------------------------------------------- */

  .groupe {
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  .groupe__titre {
    font-size: clamp(1.4rem, 3.5vw, 2.25rem);
  }

  .groupe__soustitre {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .groupe .galerie {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding-bottom: 0;
  }

  /* --- Galerie ------------------------------------------------------------ */

  .galerie {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    margin: 0 auto;
    padding-bottom: clamp(3rem, 8vw, 6rem);
    list-style: none;
  }

  /* A landscape image spans two columns when there is room for it. */
  .galerie__item--landscape {
    grid-column: span 2;
  }

  /* Une image seule n'a pas à se réduire à la largeur d'une colonne : elle
     occupe toute la mesure. */
  .galerie--solo {
    grid-template-columns: 1fr;
  }

  .galerie--solo .galerie__item--free img {
    width: 100%;
  }

  @media (max-width: 52rem) {
    .galerie__item--landscape {
      grid-column: span 1;
    }
  }

  .galerie figure {
    margin: 0;
  }

  .galerie img {
    width: 100%;
    object-fit: cover;
    background: var(--noir-doux);
  }

  .galerie__item--portrait img {
    aspect-ratio: 4 / 5;
  }

  .galerie__item--landscape img {
    aspect-ratio: 16 / 10;
  }

  .galerie__item--free img {
    aspect-ratio: auto;
  }

  .galerie figcaption {
    margin-top: 0.8rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(242 236 225 / 0.45);
  }

  .galerie__vide {
    color: var(--texte-sourd);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  /* --- Chapitre suivant --------------------------------------------------- */

  .suite__lien {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .suite__titre {
    font-family: var(--display);
    font-size: clamp(1.75rem, 6vw, 4rem);
    text-transform: uppercase;
    line-height: 1;
    transition: color var(--moyen);
  }

  .suite__lien:hover .suite__titre {
    color: var(--accent);
  }
</style>
